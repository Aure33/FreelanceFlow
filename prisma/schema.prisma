// FreelanceFlow — client Prisma typé.
// La SOURCE DE VÉRITÉ de la base est la migration SQL versionnée
// (supabase/migrations/*_init_schema_rls.sql). Ce schéma reflète cette base
// pour fournir un client typé ; les migrations ne sont PAS pilotées par Prisma.
//
// Connexion : pooler transaction mode (6543) pour l'app, directUrl (5432) pour
// l'introspection / la génération — indispensable en serverless (Vercel).
//
// Rappel sécurité : ce client se connecte via un rôle qui CONTOURNE la RLS.
// Chaque requête applicative DOIT filtrer where: { userId: session.user.id }.
// Montants en centimes entiers (Int). TVA par ligne (Decimal).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @db.Uuid // = auth.users.id (FK gérée en base, alimentée par le trigger handle_new_user)
  email     String   @unique
  name      String?
  activity  String?
  phone     String?
  address   String?
  siret     String?
  tvaRegime String   @default("reel") @map("tva_regime") // franchise | reel | normal
  planType  String   @default("free") @map("plan_type") // free | premium
  iban      String?
  bic       String?
  stripeCustomerId     String?   @unique(map: "users_stripe_customer_id_key") @map("stripe_customer_id") // #82 — posé à la 1ère session Checkout
  stripeSubscriptionId String?   @unique(map: "users_stripe_subscription_id_key") @map("stripe_subscription_id") // #82 — posé/effacé par le webhook, jamais par l'app
  // Relances automatiques (#84) — valeurs whitelistées par zod (parametres/
  // actions.ts) ; le cron ne traite que premium + remindersEnabled.
  remindersEnabled   Boolean @default(false) @map("reminders_enabled")
  reminderFirstDays  Int     @default(7) @map("reminder_first_days") // 3 | 7 | 10
  reminderSecondDays Int     @default(15) @map("reminder_second_days") // 10 | 15 | 21
  reminderFinalDays  Int     @default(30) @map("reminder_final_days") // 21 | 30 | 45
  reminderTone       String  @default("courtois") @map("reminder_tone") // courtois | neutre | ferme
  logoPath String? @map("logo_path") // objet du bucket privé `logos` (#87) : `<userId>/logo.<ext>`
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  clients       Client[]
  projects      Project[]
  documents     Document[]
  documentLines DocumentLine[]

  @@map("users")
}

model Client {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  name          String
  siret         String?
  email         String?
  phone         String?
  address       String?
  sector        String?
  paymentTerms  String?  @map("payment_terms")
  iban          String?
  bic           String?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  projects Project[]

  @@index([userId])
  @@map("clients")
}

model Project {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  clientId  String   @map("client_id") @db.Uuid
  name      String
  status    String   @default("en_cours") // en_cours | termine | en_pause
  progress  Int      @default(0) // avancement %
  notes     String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  // ON DELETE RESTRICT : impossible de supprimer un client rattaché à des projets
  client    Client     @relation(fields: [clientId], references: [id], onDelete: Restrict)
  documents Document[]

  @@index([userId])
  @@index([clientId])
  @@map("projects")
}

model Document {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  projectId     String    @map("project_id") @db.Uuid
  type          String // devis | facture
  number        String? // FAC-2026-001 — généré à l'émission (issue #8)
  status        String    @default("brouillon") // brouillon | envoye | accepte | refuse | paye | en_retard
  object        String?
  tvaRegime     String?   @map("tva_regime") // copié du user à l'émission
  totalHtCents  Int       @default(0) @map("total_ht_cents") // centimes entiers
  totalTvaCents Int       @default(0) @map("total_tva_cents") // centimes entiers
  totalTtcCents Int       @default(0) @map("total_ttc_cents") // centimes entiers
  issuedAt      DateTime? @map("issued_at") @db.Timestamptz(6) // date "métier", éditable par l'utilisateur
  emittedAt     DateTime? @map("emitted_at") @db.Timestamptz(6) // horodatage SERVEUR, jamais éditable — quota paywall (#10)
  sourceQuoteId String?   @unique(map: "documents_source_quote_id_key") @map("source_quote_id") @db.Uuid // devis d'origine si conversion (#61) — UNIQUE : un devis → une seule facture
  publicToken   String?   @unique(map: "documents_public_token_key") @map("public_token") // lien public de devis (#85) — jeton aléatoire révocable, null par défaut
  dueAt         DateTime? @map("due_at") @db.Timestamptz(6)
  paidAt        DateTime? @map("paid_at") @db.Timestamptz(6)
  emailSentAt   DateTime? @map("email_sent_at") @db.Timestamptz(6) // dernier envoi par e-mail au client (#83), horodatage SERVEUR
  reminderCount   Int       @default(0) @map("reminder_count") // relances déjà envoyées par le cron (#84), 0..3
  lastReminderAt  DateTime? @map("last_reminder_at") @db.Timestamptz(6) // horodatage SERVEUR de la dernière relance (#84) — idempotence quotidienne
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  // ON DELETE RESTRICT : impossible de supprimer un projet portant des documents
  project Project        @relation(fields: [projectId], references: [id], onDelete: Restrict)
  lines   DocumentLine[]
  // Traçabilité devis → facture (#61). SET NULL : supprimer le devis ne casse
  // jamais la facture (la trace disparaît, la pièce reste).
  sourceQuote      Document? @relation("QuoteConversion", fields: [sourceQuoteId], references: [id], onDelete: SetNull)
  convertedInvoice Document? @relation("QuoteConversion")

  @@unique([userId, number], map: "documents_user_number_key") // numérotation unique par utilisateur
  @@index([userId])
  @@index([projectId])
  @@map("documents")
}

model DocumentLine {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  documentId     String   @map("document_id") @db.Uuid
  label          String
  quantity       Decimal  @default(1) @db.Decimal(12, 2)
  unitPriceCents Int      @default(0) @map("unit_price_cents") // centimes entiers
  tvaRate        Decimal  @default(20) @map("tva_rate") @db.Decimal(5, 2) // taux TVA par ligne
  position       Int      @default(0)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([documentId])
  @@map("document_lines")
}
