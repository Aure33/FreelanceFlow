# Copier vers .env.local et remplir (Supabase → Settings → API / Database)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxx
SUPABASE_SECRET_KEY=sb_secret_xxxx

# Optionnel : URL publique de secours pour construire le lien de réinitialisation
# de mot de passe (l'origin des headers est utilisé en priorité).
# NEXT_PUBLIC_SITE_URL=https://freelanceflow.vercel.app

# Prisma (pooler 6543 pour l'app, direct 5432 pour les migrations)
#
# connection_limit : NE PAS remettre à 1. Les pages qui lancent plusieurs
# requêtes en parallèle (tableau de bord : layout + getDashboardData) se
# sérialisent alors sur une seule connexion et dépassent le pool_timeout —
# erreur « Timed out fetching a new connection from the connection pool ».
# 5 connexions suffisent largement et restent sans risque pour le pooler
# Supabase (mode transaction). pool_timeout monté à 20 s par sécurité réseau.
DATABASE_URL="postgresql://postgres.xxxx:MDP_ENCODE_URL@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5&pool_timeout=20"
DIRECT_URL="postgresql://postgres.xxxx:MDP_ENCODE_URL@aws-0-region.pooler.supabase.com:5432/postgres"
